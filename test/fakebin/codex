#!/usr/bin/env node
// A stand-in for `codex` in tests. FAKE_CODEX = complete | blocked | partial | nowrite | fail | hang | writer | turnonly.
import { readFileSync, writeFileSync, appendFileSync } from "node:fs";
const args = process.argv.slice(2);
if (args[0] === "login") { console.log(process.env.FAKE_AUTH ?? "Logged in using ChatGPT"); process.exit(0); }
const mode = process.env.FAKE_CODEX ?? "complete";
const o = args[args.indexOf("-o") + 1];
const prompt = readFileSync(0, "utf8");
const reply = /^REPORT_FILE: (.+)$/m.exec(prompt)?.[1];
if (process.env.FAKE_ARGV_LOG) appendFileSync(process.env.FAKE_ARGV_LOG, JSON.stringify({ argv: args, cwd: process.cwd(), keys: ["OPENAI_API_KEY", "CODEX_API_KEY", "ANTHROPIC_API_KEY"].filter((k) => process.env[k]) }) + "\n");
const out = (e) => process.stdout.write(JSON.stringify(e) + "\n");
if (mode === "writer") { process.stderr.write("thread already has an active writer\n"); process.exit(1); }
if (mode === "fail") { process.stderr.write("boom\n"); process.exit(3); }
out({ type: "thread.started", thread_id: process.env.FAKE_SESSION ?? "sess-1" });
out({ type: "turn.started" });
const status = mode === "blocked" ? "blocked" : mode === "partial" ? "partial" : "complete";
const text = `Decision: done. Blocking findings: 0.\nWe mention STATUS: blocked inside the text on purpose.\nFull report body.` + (mode === "nostatus" ? `\nSTATUS: complete\nand then more text` : `\nSTATUS: ${status}`);
if (mode === "turnonly") { if (reply) writeFileSync(reply, text); writeFileSync(o, text); out({ type: "turn.completed", usage: {} }); setInterval(() => {}, 1000); }
else if (mode === "hang") setInterval(() => {}, 1000);
else {
  if (reply && mode !== "nowrite") writeFileSync(reply, text + "\n");
  writeFileSync(o, reply ? `Summary only.\nSTATUS: ${status}` : text);
  out({ type: "item.completed", item: { type: "agent_message", text } });
  out({ type: "turn.completed", usage: {} });
}
